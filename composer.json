{
  "name": "keychat/bots",
  "description": "Official PHP SDK for Key Chat bots",
  "keywords": ["keychat", "bot", "webhook", "chat"],
  "homepage": "https://github.com/mikhailrepka/keychat-bots-php",
  "type": "library",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/mikhailrepka/keychat-bots-php/issues",
    "source": "https://github.com/mikhailrepka/keychat-bots-php"
  },
  "require": { "php": ">=8.1", "ext-curl": "*", "ext-json": "*" },
  "autoload": { "psr-4": { "KeyChat\\Bots\\": "src/" } },
  "require-dev": { "phpunit/phpunit": "^10.5 || ^11.0", "phpdocumentor/phpdocumentor": "^3.5" },
  "scripts": {
    "test": "phpunit tests",
    "docs": "phpdoc -d src -t docs"
  }
}
